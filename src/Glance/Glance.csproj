<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Glance</AssemblyName>
    <RootNamespace>Glance</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>glance.ico</ApplicationIcon>
    <Product>Glance</Product>
    <Description>Glance model viewer</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Native AOT: no runtime to start, so the window is up in milliseconds. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <DebugType>none</DebugType>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- The brand typeface, built in (see src\Shared\BundledFonts.cs and tools\make_fonts.py). -->
  <ItemGroup>
    <Compile Include="..\Shared\BundledFonts.cs" Link="BundledFonts.cs" />
    <Compile Include="..\Shared\AppVersion.cs" Link="AppVersion.cs" />
    <EmbeddedResource Include="..\Glance\fonts\GlanceRoboto-Regular.ttf" LogicalName="GlanceRoboto-Regular.ttf" />
    <EmbeddedResource Include="..\Glance\fonts\GlanceRoboto-Medium.ttf" LogicalName="GlanceRoboto-Medium.ttf" />
    <EmbeddedResource Include="..\Glance\fonts\GlanceRoboto-Light.ttf" LogicalName="GlanceRoboto-Light.ttf" />
  </ItemGroup>

</Project>
